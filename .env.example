# 复制为 .env 后按需修改；.env 本身不会被提交（见 .gitignore）。
# 所有取值均为占位符，不含真实凭据。

REPOPILOT_ENV=dev

# --- API ---
REPOPILOT_API_TOKEN=local-dev-token
REPOPILOT_API_HOST=127.0.0.1
REPOPILOT_API_PORT=8080

# --- PostgreSQL（docker-compose 把容器内 5432 映射到宿主机 5433） ---
REPOPILOT_POSTGRES_DSN=postgresql+asyncpg://repopilot:repopilot@localhost:5433/repopilot

# --- Temporal ---
REPOPILOT_TEMPORAL_ADDRESS=localhost:7233
REPOPILOT_TEMPORAL_NAMESPACE=repopilot-dev

# --- MinIO ---
REPOPILOT_MINIO_ENDPOINT=http://localhost:9000
REPOPILOT_MINIO_ACCESS_KEY=repopilot
REPOPILOT_MINIO_SECRET_KEY=repopilot-secret
REPOPILOT_MINIO_BUCKET=repopilot-artifacts

# --- Model Gateway（留空则只能使用 FakeModelProvider） ---
REPOPILOT_MODEL_BASE_URL=
REPOPILOT_MODEL_API_KEY=
REPOPILOT_MODEL_NAME=fake-model
REPOPILOT_MODEL_INPUT_USD_PER_MILLION_TOKENS=0
REPOPILOT_MODEL_OUTPUT_USD_PER_MILLION_TOKENS=0
REPOPILOT_MODEL_RESERVATION_USD=0.10

# --- Sandbox RPC（必须是 loopback 地址） ---
REPOPILOT_SANDBOX_SERVICE_URL=http://127.0.0.1:8091
REPOPILOT_SANDBOX_SERVICE_TOKEN=local-sandbox-token
REPOPILOT_PYPI_PROXY_URL=http://pypi-proxy:3128
REPOPILOT_PYPI_EGRESS_NETWORK=repopilot-pypi-egress

# --- 数据目录（绝对路径，clone/worktree/沙箱产物落盘位置） ---
REPOPILOT_DATA_DIR=./.repopilot
